# ==============================================================================
# USB Sentinel - Universal AI Provider Configuration
# ==============================================================================
# Pilih provider yang ingin digunakan:
# Options: gemini | openai | anthropic | groq | ollama | mock
AI_PROVIDER=gemini

# ------------------------------------------------------------------------------
# 1. Google Gemini API (Rekomendasi Utama: Sangat Cepat & Efisien)
# Dapatkan API Key di: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. OpenAI API
# Dapatkan API Key di: https://platform.openai.com/api-keys
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# 3. Groq API (Inference Kecepatan Ultra-Tinggi Llama-3)
# Dapatkan API Key di: https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 4. Anthropic Claude API
# Dapatkan API Key di: https://console.anthropic.com/
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ------------------------------------------------------------------------------
# 5. Ollama Local LLM (100% Offline / Air-Gapped Kiosk - Tanpa Internet)
# Jalankan di lokal: ollama run llama3:latest
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# ------------------------------------------------------------------------------
# 6. Global Threat Intelligence: MalwareBazaar (abuse.ch) & vx-underground
# Dapatkan Auth-Key gratis di: https://auth.abuse.ch/
# Digunakan untuk query reputasi jutaan hash malware in-the-wild secara real-time
# ------------------------------------------------------------------------------
MALWAREBAZAAR_API_KEY=
MB_API_KEY=

# ------------------------------------------------------------------------------
# Konfigurasi Gateway Internal
# ------------------------------------------------------------------------------
SENTINEL_DEVICE_TOKEN=sentinel-dev-station-01
SENTINEL_GATEWAY_URL=http://gateway.local:8080
